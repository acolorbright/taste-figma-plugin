FROM python:3.12-slim
WORKDIR /app
COPY server/requirements.txt /app/server/requirements.txt
RUN pip install --no-cache-dir torch==2.10.0 torchvision==0.25.0 --index-url https://download.pytorch.org/whl/cpu && pip install --no-cache-dir -r server/requirements.txt
COPY server /app/server
COPY deploy-data /app/library
RUN useradd --create-home app && chown -R app:app /app
USER app
# Bake model weights into the image so restarts do not require a model download.
RUN python -c "from server.search import Encoder; Encoder()"
ENV TASTE_LIBRARY_PATH=/app/library
EXPOSE 8765
CMD ["python", "-m", "server.run", "--host", "0.0.0.0"]
